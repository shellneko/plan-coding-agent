function_descriptions = """\
1. nav(waypoint_name: str):
    指定したウェイポイントまで自律ナビゲーションを行う。指定可能なウェイポイントは以下の通りである。
    {{"テレビ前": "目の前にテレビが見える", "地点A": "目の前に机が見える", "地点B": "目の前には赤いスーツケースがある"}}

2. query_camera(query: str) -> bool:
    カメラの内容とクエリの内容が一致していたらTrue, そうでなければFalseを返す。

3. walk(x: float, yaw: float):
    yaw(度)回転した後、x(m)直進する。yawは正で左回り、負で右回り。xは正で前進、負で後退。

4. draw_heart():
    手でハートを描く。

5. stretch():
    ストレッチする。

6. dance():
    ダンスする。

7. wave_hand():
    手を振る。

8. speak(text: str):
    textの内容を音声に変換してスピーカーで再生する。

17. analyze_camera() -> str:
    カメラ画像の状況を説明した文が返ってくる。
"""
